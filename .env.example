# ==========================================
# CONFIGURACIÓN DE ENTORNO SH AUTOMOTORES
# ==========================================

# ------------------------------------------
# 1. PERFIL: LOCALHOST (Desarrollo)
# Descomentar estas líneas si vas a probar el proyecto en tu PC (Docker Desktop)
# ------------------------------------------
VITE_API_URL=http://localhost:50001/api
PUBLIC_IP=localhost
FRONT_PORT=51001
BACK_PORT=50001

# ------------------------------------------
# 2. PERFIL: PRODUCCIÓN VPS (Hostinger)
# Descomentar estas líneas y cambiar la IP cuando subas al servidor
# ------------------------------------------
# VITE_API_URL=http://123.45.67.89:50001/api
# PUBLIC_IP=123.45.67.89
# FRONT_PORT=51001
# BACK_PORT=50001

# ==========================================
# CONFIGURACIÓN INTERNA DE CONTENEDORES
# No tocar esto al menos que sepas qué haces
# ==========================================

# -- BASE DE DATOS (PostgreSQL) --
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=shautomotores_db
DB_HOST=db
DB_PORT=5432

# Configuración de Cloudinary para carga de imágenes
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Configuración de Servidor de Correos (Nodemailer para leads)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Correo que autorizará el envío:
SMTP_USER=tu_correo@gmail.com
# Contraseña de aplicación (Si usas Gmail):
SMTP_PASS=tu_password_de_aplicacion
SMTP_FROM_NAME="SH Automotores Web"

# -- BACKEND --
JWT_SECRET=super_secret_jwt_key_that_should_be_changed_in_prod

# -- FRONTEND --
# El frontend en Vite lee las variables locales (VITE_) que inyectamos.
# Para nginx el router no usa env en tiempo real, Vite lo compila.
